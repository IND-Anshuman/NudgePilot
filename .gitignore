# .gitignore — .env must NEVER be committed (secrets hygiene)
.env
.env.*
!*.example
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
nudgepilot_drafts/
dist/
build/
.pytest_cache/
.mypy_cache/

# local tooling / personal dirs that must NEVER enter the submission
.hermes/
# stray duplicates (the real packages live at repo root)
deploy/agents/
deploy/cloud/
deploy/core/
deploy/delivery/