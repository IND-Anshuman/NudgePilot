# ---- NudgePilot environment (copy to .env and fill in) ----
# The demo runs with NO vars. Set these to use real Google services.

# LLM backend. Choices:
#   GOOGLE_API_KEY=...        -> use real Gemini (google-genai)
#   (or) GOOGLE_GENAI_USE_VERTEXAI=1 + GOOGLE_CLOUD_PROJECT + ADC for Vertex
# If none set, the deterministic offline backend is used (zero-cred demo).
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=

# Storage backend: memory (default, demo) | firestore (production)
NUDGEPILOT_STORE=memory

# Agent behavior / policy tuning (see core/policy.py for defaults)
NUDGE_FIRST_DAYS=7
NUDGE_GAP_DAYS=7
NUDGE_CEILING=2
GHOST_CUTOFF_DAYS=21

# Delivery
NUDGEPILOT_DRAFTS_DIR=./nudgepilot_drafts